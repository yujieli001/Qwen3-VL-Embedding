[Unit]
Description=Qwen3-VL OpenAI-compatible API Service
After=network.target

[Service]
Type=simple
User=li
Group=li
WorkingDirectory=/data/Qwen3-VL-Embedding
Environment="PATH=/data/Qwen3-VL-Embedding/.venv/bin"
Environment="CUDA_VISIBLE_DEVICES="
ExecStart=/data/Qwen3-VL-Embedding/.venv/bin/python -m uvicorn servers.openai_proxy:app --host 0.0.0.0 --port 10013
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qwen3-vl-api

# Memory and CPU limits
MemoryMax=32G
CPUQuota=400%

[Install]
WantedBy=multi-user.target
