# ============== 设备配置 ==============
# Embedding 是否使用 GPU（true/false）
USE_EMBEDDING_GPU=true
# Embedding GPU 设备 ID（仅当 USE_EMBEDDING_GPU=true 时有效）
# 注意：GPU 0 和 GPU 1 都被 VLLM 占用，各剩约 15GB 空闲显存
# 2B 模型约需 6-8GB，可以使用任意一张 GPU 的剩余显存
EMBEDDING_CUDA_DEVICE=0

# Reranker 是否使用 GPU（true/false）
USE_RERANKER_GPU=true
# Reranker GPU 设备 ID（仅当 USE_RERANKER_GPU=true 时有效）
# GPU 0 只剩约 6GB 显存，使用 GPU 1（约 15GB 空闲）
RERANKER_CUDA_DEVICE=1

# ============== 模型路径 ==============
EMBEDDING_MODEL_PATH=/model/Qwen3-VL-Embedding-2B
RERANKER_MODEL_PATH=/model/Qwen3-VL-Reranker-2B

# ============== 线程配置 ==============
# Workers 数量：每个 worker 会加载一份完整模型，显存紧张时设为 1
# 当前每张 GPU 约剩 6-7GB，单 worker 约需 4.7GB
UVICORN_WORKERS=1
OMP_NUM_THREADS=16
MKL_NUM_THREADS=16
OPENBLAS_NUM_THREADS=16
NUMEXPR_NUM_THREADS=16
PYTORCH_NUM_THREADS=16
TOKENIZERS_PARALLELISM=false