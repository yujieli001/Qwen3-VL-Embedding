# ============== 设备配置 ==============
# Embedding 是否使用 GPU（true/false）
USE_EMBEDDING_GPU=false
# Embedding GPU 设备 ID（仅当 USE_EMBEDDING_GPU=true 时有效）
EMBEDDING_CUDA_DEVICE=1

# Reranker 是否使用 GPU（true/false）
USE_RERANKER_GPU=false
# Reranker GPU 设备 ID（仅当 USE_RERANKER_GPU=true 时有效）
RERANKER_CUDA_DEVICE=0

# ============== 模型路径 ==============
EMBEDDING_MODEL_PATH=/model/Qwen3-VL-Embedding-2B
RERANKER_MODEL_PATH=/model/Qwen3-VL-Reranker-2B

# ============== 线程配置 ==============
UVICORN_WORKERS=2
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
NUMEXPR_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
